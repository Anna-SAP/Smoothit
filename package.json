  },
  "homepage": "https://github.com/Anna-SAP/Smoothit#readme",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.2.3"
  },
  "private": true,
  "type": "module"
