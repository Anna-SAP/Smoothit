{
  "name": "smoothit",
  "version": "0.1.0",
  "description": "Smoothit — one-tap studio-grade selfie camera",
  "scripts": {
    "assets": "node scripts/fetch-assets.mjs",
    "predev": "npm run assets",
    "dev": "vite",
    "prebuild": "npm run assets",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev:https": "npm run assets && SMOOTHIT_HTTPS=1 vite",
    "sync": "npm run build && cap sync",
    "android": "npm run sync && cap open android",
    "ios": "npm run sync && cap open ios",
    "test:visual": "node scripts/visual-test.mjs",
    "test:e2e": "node scripts/e2e.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Anna-SAP/Smoothit.git"
  },
  "bugs": {
    "url": "https://github.com/Anna-SAP/Smoothit/issues"
  },
  "homepage": "https://github.com/Anna-SAP/Smoothit#readme",
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@mediapipe/tasks-vision": "^1.2.3"
  },
  "private": true,
  "type": "module"
}
